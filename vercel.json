{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "unzip -q releases/MOA_home_editorial_cards_preview_20261114.zip -d . && sed -i 's/ES2020/ES2022/g' moa-web/tsconfig.json && cd moa-web && npm ci && npm run build",
  "outputDirectory": "moa-web/dist",
  "rewrites": [
    {
      "source": "/api/v4/:path*",
      "destination": "/api/moa-gateway?path=:path*"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "node_modules/pretendard/{package.json,dist/public/static/alternative/Pretendard-{Regular,SemiBold,Bold}.ttf}"
    }
  },
  "regions": [
    "icn1"
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
