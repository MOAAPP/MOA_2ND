{
  "name": "moa",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle:api": "esbuild server/vercel-entry.ts --bundle --platform=node --format=esm --target=node22 --outfile=api/index.mjs --external:@resvg/resvg-js --log-level=warning --banner:js=\"import { createRequire as __cr } from 'module'; const require = __cr(import.meta.url);\""
  },
  "license": "ISC",
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vercel/oidc": "^3.8.10",
    "express": "^4.22.3",
    "pretendard": "^1.3.9",
    "satori": "^0.10.14",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "private": true,
  "type": "module"
}
