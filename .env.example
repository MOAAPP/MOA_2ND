# ── 서버 전용 환경변수 (아래 VITE_FINANCE_API_BASE 공개 URL은 React 번들에 포함됩니다) ──

# Discord 카드뉴스 전송 목적지 (필수: Discord 기능)
DISCORD_WEBHOOK_URL=

# 시세 제공처: auto(기본) | kis | naver | yahoo | demo
#  auto = KIS 키가 있으면 KIS → 네이버 → Yahoo, 없으면 네이버 → Yahoo 순서로 자동 전환
QUOTE_PROVIDER=auto

# 한국투자증권 KIS Open API (실시간 체결가 웹소켓 + 현재가·지수·일봉 REST)
# https://apiportal.koreainvestment.com 에서 계좌 개설 후 앱키 발급
KIS_APP_KEY=
KIS_APP_SECRET=
# real(실전) | mock(모의투자 도메인)
KIS_ENV=real
# 실시간 웹소켓을 끄려면 off
KIS_REALTIME=on

# 카드뉴스 자료 사진 (선택: 없으면 사진 없이 만들고 카드에 표시)
# Pixabay: https://pixabay.com/api/docs/ 에서 로그인하면 키가 바로 보여요 (둘 다 있으면 Pixabay 우선)
PIXABAY_API_KEY=
# Pexels: 현재 신규 키 발급이 중단된 상태
PEXELS_API_KEY=

# ── AI (선택: 없으면 예시 응답·규칙 기반으로 동작) ──
# 결제 문자 정리, 브리핑·코치, '왜 움직였을까' 문장, 가격표·영수증 사진 판독에 쓰여요.
# 1순위: 서울여대 FactChat 게이트웨이 (OpenAI 호환). 키 발급: https://swu.factchat.bot/dashboard/developers?tab=keys
#   Vercel에도 같은 이름으로 넣어 주세요 (Settings → Environment Variables). VITE_ 접두사는 붙이지 마세요.
FACTCHAT_API_KEY=
# off로 두면 키는 그대로 두고 AI 호출만 꺼요 (크레딧 아끼기)
AI_ENABLED=
# 기본 https://factchat-cloud.mindlogic.ai/v1/gateway — 학교 전용 주소를 안내받았다면 바꿔요
FACTCHAT_BASE_URL=
# 기본 claude-sonnet-5 — 게이트웨이 /models 목록에 있는 이름만 쓸 수 있어요
FACTCHAT_MODEL=
# 2순위: Anthropic 직접 호출 (FACTCHAT_API_KEY가 없을 때만)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# 최저가 찾기 (선택: 없으면 쇼핑몰 검색 링크만 보여줘요)
# https://developers.naver.com/apps 에서 '검색' API 애플리케이션 등록 후 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 데일리 카드뉴스에 넣을 앱 주소 (선택, 예: https://moa.example.com)
APP_URL=

# 데일리 스케줄러 끄기: off
DAILY_SCHEDULER=on

PORT=8787

# ── 별도 FastAPI 금융 계산 백엔드 (프론트 빌드 시 공개 URL 주입) ──
# 개발에서는 비워 두면 Vite 프록시가 /api/v4 -> localhost:8000 으로 보냅니다.
# 배포 시 별도 FastAPI 공개 주소를 넣고 백엔드 MOA_CORS_ORIGINS에 프론트 URL을 허용하세요.
VITE_FINANCE_API_BASE=
