# ── 서버 전용 환경변수 (React 번들에 들어가지 않습니다) ──

# Discord 카드뉴스 전송 목적지 (필수: Discord 기능)
DISCORD_WEBHOOK_URL=

# 시세 제공처: auto(기본) | kis | naver | yahoo | demo
#  auto = KIS 키가 있으면 KIS → 네이버 → Yahoo, 없으면 네이버 → Yahoo 순서로 자동 전환
QUOTE_PROVIDER=auto

# 한국투자증권 KIS Open API (실시간 체결가 웹소켓 + 현재가·지수·일봉 REST)
# https://apiportal.koreainvestment.com 에서 계좌 개설 후 앱키 발급
KIS_APP_KEY=
KIS_APP_SECRET=
# real(실전) | mock(모의투자 도메인)
KIS_ENV=real
# 실시간 웹소켓을 끄려면 off
KIS_REALTIME=on

# 카드뉴스 자료 사진 (선택: 없으면 사진 없이 만들고 카드에 표시)
# Pixabay: https://pixabay.com/api/docs/ 에서 로그인하면 키가 바로 보여요 (둘 다 있으면 Pixabay 우선)
PIXABAY_API_KEY=
# Pexels: 현재 신규 키 발급이 중단된 상태
PEXELS_API_KEY=

# '왜 움직였을까' 문장 다듬기 + 가격표·영수증 사진 판독 (선택: 없으면 규칙 기반 문장, 사진은 브라우저에서 직접 읽음)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# 최저가 찾기 (선택: 없으면 쇼핑몰 검색 링크만 보여줘요)
# https://developers.naver.com/apps 에서 '검색' API 애플리케이션 등록 후 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 데일리 카드뉴스에 넣을 앱 주소 (선택, 예: https://parallel-bank.example.com)
APP_URL=

# 데일리 스케줄러 끄기: off
DAILY_SCHEDULER=on

PORT=8787
